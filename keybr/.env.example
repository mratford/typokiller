APP_URL=http://localhost:3000/
# Detailed recording does not use the session cookie, so it also works on
# addresses other than localhost (see docs/detailed_recording.md).
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
DATA_DIR=~/.local/state/keybr

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=~/.local/state/keybr/database.sqlite

MAIL_DOMAIN=localhost
MAIL_KEY=
MAIL_FROM_ADDRESS=user@localhost
MAIL_FROM_NAME=user

# Personal detailed recording. The servers then listen on all network
# interfaces, and accept only a Host that is localhost, an IP address or a
# name that ends in .local (see docs/detailed_recording.md).
DETAILED_RECORDING=false
# The address of typokiller, which gives the keyboards for detailed recording.
# When it is not set, keybr does not ask typokiller.
# TYPOKILLER_URL=http://127.0.0.1:8000
